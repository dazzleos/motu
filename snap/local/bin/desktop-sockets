#!/bin/sh
# Points Motu at the desktop's Wayland socket. Under strict confinement
# XDG_RUNTIME_DIR is the snap's own directory inside the user's, while the
# socket stays in the user's, where the wayland interface lets the snap
# reach it.
user_runtime_dir=$(dirname "$XDG_RUNTIME_DIR")

case ${WAYLAND_DISPLAY:=wayland-0} in
/*) ;;
*) WAYLAND_DISPLAY="$user_runtime_dir/$WAYLAND_DISPLAY" ;;
esac
export WAYLAND_DISPLAY

exec "$@"
